DATABASE_URL=postgres://usuario:senha@host:5432/banco?sslmode=require
JWT_SECRET=troque-esta-chave-por-uma-chave-longa-em-producao
INTEGRATION_ENCRYPTION_KEY=troque-por-uma-chave-longa-exclusiva-para-credenciais
PORT=5173

# Integracoes externas
# Credenciais (app_key/app_secret da OMIE, tokens de outras APIs) NAO ficam aqui: sao
# cadastradas pela Central de Integracoes e gravadas criptografadas no banco.
# O agendador vale para todas as integracoes registradas, nao so para a OMIE.
INTEGRATIONS_SCHEDULER_ENABLED=true
INTEGRATIONS_SCHEDULER_TICK_MS=15000
# Tempo limite das chamadas a OMIE
OMIE_TIMEOUT_MS=15000
CRON_SECRET=troque-por-um-segredo-para-o-gatilho-externo-opcional-de-cron

# Fotos de avarias
# Servidor roda sempre ativo (nao serverless), entao o disco local e duravel.
# Use s3/r2 apenas se quiser guardar fora do servidor local.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=.storage
STORAGE_ALLOW_LOCAL_IN_PRODUCTION=false
STORAGE_ENDPOINT=
STORAGE_BUCKET=avarias-fotos
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
UPLOAD_MAX_IMAGE_MB=8
UPLOAD_MAX_IMAGES_PER_ITEM=12
