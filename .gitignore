node_modules/
.pnpm-store/
__pycache__/
*.pyc

# Variaveis de ambiente e segredos locais (.env, .env.local, .env.production.local, .bak ...)
.env*
.streamlit/secrets.toml
.claude/settings.local.json

# Dados reais de producao -- nunca versionar
# backups/ contem estrutura + dados; .storage/ sao as fotos de avaria
backups/
.storage/

# Dumps com dados. O unico dump versionado e o de estrutura (schema-only), liberado abaixo.
*.dump
!db/estrutura.dump

# Rascunhos, logs e artefatos de execucao local
logs_rascunhos/
.codex-temp/
.local-app-logs/
test-results/
playwright-report/
*.log
